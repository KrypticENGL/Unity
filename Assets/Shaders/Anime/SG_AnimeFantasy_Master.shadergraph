{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "468d3441192f50df90fe8c1721612d45",
    "m_Title": "05 SHADOW BANDS",
    "m_Content": "Shadows are hue-shifted toward Shadow Color (e.g. ivory -> lavender), never black. Mid band tinted by Mid Color. Form Retention keeps curved roofs/towers volumetric inside each band.",
