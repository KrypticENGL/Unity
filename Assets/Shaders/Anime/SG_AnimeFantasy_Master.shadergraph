{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "da147b73c8795289be0002895138694a",
    "m_Title": "SG_AnimeFantasy_Master",
    "m_Content": "Anime fantasy master shader.\nGeometry normal -> main light -> N.L -> toon bands -> colored shadow -> ambient -> rim -> stylized specular -> final color.\n\nURP Lit target used as a container: Base Color / Specular are black and Smoothness 0, so URP adds nothing. The stylized color goes to Emission. This keeps real-time shadows, Forward+ lights, fog, depth/normals, SSAO normals and shadow casting from URP.\n\nMath lives in Include/AnimeLighting.hlsl (one function per group). No textures.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -5200.0,
        "y": -1350.0,
        "width": 520.0,
        "height": 300.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

